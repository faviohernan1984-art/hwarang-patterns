VITE_APP_ENV=development
VITE_FIREBASE_PROJECT_ID=demo-patterns-gups
VITE_FIREBASE_USE_EMULATOR=true
VITE_FIREBASE_ALLOW_PRODUCTION=false
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_ALLOW_LAN=false
VITE_FIRESTORE_EMULATOR_PORT=8080
VITE_AUTH_EMULATOR_PORT=9099

# DEV only. Copy to an ignored .env; never put Admin secrets in VITE_* variables.
# Production requires API_KEY, AUTH_DOMAIN, PROJECT_ID and APP_ID plus explicit selectors.
# Production accepts only the approved Patterns Project ID / App ID pair in firebaseConfig.js.
# This example remains Emulator-only; do not use it as a production environment file.
# Production must not contain emulator host, ports or ALLOW_LAN variables.
